# LLM API key (required — pick one)
GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default model
# LLM_MODEL=gemini-2.5-flash

# Optional: real HITL interrupts (default: mock approval)
# LANGGRAPH_INTERRUPT=true

# Optional: structured LLM-as-judge (default: heuristic evaluator)
# LLM_JUDGE_ENABLED=true
# LLM_JUDGE_MAX_CALLS=2
# LLM_JUDGE_TIMEOUT_SECONDS=5

# Optional: persistence backend
CHECKPOINTER=memory
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_lab

LOG_LEVEL=INFO
